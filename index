x:'Mathematical verification checks the calculations. Real-world validation requires appropriate evidence beyond this simplified model.',
m(b){const sts=['The formula matches repeated calculations.','Matching calculations proves the model is accurate for every patient.','The model assumes complete, instantaneous input.','200 mg is a universal safety threshold.','Total amount in mg is different from blood concentration in mg/L.'];
b.innerHTML=`<div class="card pl"><h3>Part A</h3><label>Number of doses: <select id="nd">${[...Array(12)].map((_,i)=>`<option value="${i+1}" ${i==2?'selected':''}>${i+1}</option>`).join('')}</select></label><div id="ra" class="eq">Submit to see the total.</div><fieldset><legend>Part B: select all true statements</legend>${sts.map((t,i)=>`<label><input type="checkbox" id="c${i}"> ${t}</label>`).join('')}</fieldset></div>`},
c(){const n=+$('#nd').value,v=S_(n),p=v/2;$('#ra').textContent=`S${n} = ${fx(v,4)} mg = ${fx(p,4)}% of 200 mg`;const ts=[0,1,2,3,4].map(i=>$('#c'+i).checked),ex=[1,0,1,0,1].map(Boolean),ps=[];
if(n!=7)ps.push(p>=99?'Part A: a smaller number of doses already reaches 99%.':'Part A: this total is below 99%—try more doses.');if(ts.some((x,i)=>x!=ex[i]))ps.push('Part B: re-read each statement; verification is not the same as validation.');
return ps.length?{k:false,m:ps.join(' ')}:{k:true,m:'S₆ = 196.875 mg (98.4375%) is just short; S₇ = 198.4375 mg (99.21875%) is the first to reach 99%. Part B is also correct.',d:1}}}
];
/* Embedded sound files (mp3, base64): correct-answer tone and failing/wrong tone */
const SND={ok:'',no:''};
/* ================= AUDIO MODULE (Web Audio API; no files, no network) ================= */
const Aud=(()=>{
let ctx=null,mg=null,want=false,armed=false,vol=.15,act=[],until=0,cur=0,lastSel=-1,ep=0,bufs={};
try{const p=JSON.parse(localStorage.getItem('btlA')||'null');if(p){want=!!p.on;const v=+p.vol;if(v>=0&&v<=1)vol=v}}catch(e){}
const save=()=>{try{localStorage.setItem('btlA',JSON.stringify({on:want,vol}))}catch(e){}};
function ensure(){if(!want||!armed)return false;try{if(!ctx){const C=window.AudioContext||window.webkitAudioContext;if(!C)return false;ctx=new C();mg=ctx.createGain();mg.gain.value=vol;mg.connect(ctx.destination);load()}if(ctx.state==='suspended')ctx.resume();return true}catch(e){return false}}
function load(){for(const k in SND){try{const bin=atob(SND[k]),u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);bufs[k]=new Promise(res=>{try{const q=ctx.decodeAudioData(u.buffer,res,()=>res(null));if(q&&q.catch)q.catch(()=>res(null))}catch(e){res(null)}})}catch(e){bufs[k]=Promise.resolve(null)}}}
/* smp(name, gain, fallback): plays an embedded sample through the master volume; falls back to a synthesised tone if it cannot be decoded */
function smp(k,gv,fb){const my=ep,pr=bufs[k];if(!pr){fb&&fb();return}pr.then(buf=>{if(my!==ep||!ctx||!want)return;if(!buf){fb&&fb();return}try{const src=ctx.createBufferSource(),g=ctx.createGain();src.buffer=buf;g.gain.value=gv;src.connect(g);g.connect(mg);src.start();const r=[src,g];act.push(r);src.onended=()=>{try{src.disconnect();g.disconnect()}catch(e){}act=act.filter(x=>x!==r)}}catch(e){}})}
function stop(){ep++;if(ctx)act.forEach(([o,g])=>{try{const t=ctx.currentTime;g.gain.cancelScheduledValues(t);g.gain.setTargetAtTime(0,t,.01);o.stop(t+.06)}catch(e){}});act=[];until=0;cur=0}
function tone(f,t,d,o={}){try{const s=ctx.currentTime+t,osc=ctx.createOscillator(),g=ctx.createGain();let n=osc;osc.type=o.ty||'sine';osc.frequency.setValueAtTime(o.f0||f,s);if(o.f0)osc.frequency.exponentialRampToValueAtTime(f,s+d*.6);
if(o.lp){const l=ctx.createBiquadFilter();l.type='lowpass';l.frequency.value=o.lp;osc.connect(l);n=l}
g.gain.setValueAtTime(.0001,s);g.gain.linearRampToValueAtTime(o.p||.4,s+(o.a||.012));g.gain.exponentialRampToValueAtTime(.0001,s+d);n.connect(g);g.connect(mg);osc.start(s);osc.stop(s+d+.03);
const r=[osc,g];act.push(r);osc.onended=()=>{try{osc.disconnect();g.disconnect();if(n!==osc)n.disconnect()}catch(e){}act=act.filter(x=>x!==r)}}catch(e){}}
/* play(priority, seconds, builder, cooldown): no queueing; lower or equal priority is skipped while a sound is playing; higher priority replaces it */
function play(pri,dur,fn,cool){try{if(!ensure())return;const now=ctx.currentTime;if(cool&&lastSel>=0&&now-lastSel<cool)return;if(now<until){if(pri<=cur)return;stop()}cur=pri;until=now+dur;if(cool)lastSel=now;fn(tone,smp)}catch(e){}}
return{play,stop,on:()=>want,vol:()=>vol,arm:()=>{armed=true},
setOn(b){want=b;if(b)armed=true;else stop();save()},setVol(v){vol=v;if(mg)mg.gain.setTargetAtTime(vol,ctx.currentTime,.03);save()}}})();
/* ---- the 13 action sounds ---- */
const playStart=()=>Aud.play(2,.32,T=>{T(523.25,0,.19,{p:.42});T(1046.5,0,.12,{p:.06});T(783.99,.13,.19,{p:.4});T(1568,.13,.12,{p:.05})});
const playSelect=()=>Aud.play(1,.08,T=>T(300,0,.07,{f0:480,a:.004,p:.3}),.11);
const playMove=()=>Aud.play(1,.11,T=>T(392,0,.11,{ty:'triangle',lp:1600,a:.006,p:.45}));
const playRetain=()=>Aud.play(1,.2,T=>{T(659.25,0,.11,{ty:'triangle',lp:2200,p:.38});T(440,.09,.12,{ty:'triangle',lp:2200,p:.38})});
const playAdd=()=>Aud.play(1,.2,T=>{T(440,0,.11,{ty:'triangle',lp:2200,p:.38});T(659.25,.09,.12,{ty:'triangle',lp:2200,p:.38})});
const playCorrect=()=>Aud.play(2,.5,(T,S)=>S('ok',.7,()=>{T(659.25,0,.3,{p:.38});T(880,.1,.22,{p:.36})}));
const playIncorrect=()=>Aud.play(1,.5,(T,S)=>S('no',.6,()=>T(196,0,.19,{ty:'triangle',lp:500,a:.02,p:.5})));
const playHint=()=>Aud.play(1,.16,T=>{T(880,0,.15,{a:.02,p:.26});T(886,0,.15,{a:.02,p:.2});T(1760,0,.1,{a:.02,p:.05})});
const playLevelComplete=()=>Aud.play(3,.52,T=>{T(523.25,0,.22,{p:.38});T(659.25,.14,.22,{p:.38});T(783.99,.28,.24,{p:.4})});
const playLevelOpen=()=>Aud.play(1,.08,T=>T(620,0,.08,{lp:1500,a:.004,p:.3}));
const playIntervalChange=()=>Aud.play(1,.06,T=>T(720,0,.06,{a:.004,p:.3}));
const playGameComplete=()=>Aud.play(4,1.05,T=>{T(523.25,0,.35,{p:.33});T(659.25,.2,.35,{p:.33});T(783.99,.4,.4,{p:.33});[523.25,659.25,783.99,1046.5].forEach(f=>T(f,.6,.45,{a:.03,p:.2}))});
const playReset=()=>Aud.play(2,.26,T=>{T(523.25,0,.14,{p:.36});T(392,.11,.16,{p:.34})});
/* ================= end audio module ================= */
function head(){$('#sc').textContent='Score: '+st.s+' / 960';const n=st.d.filter(Boolean).length;$('#pg').value=n;$('#pt').textContent=n+'/8 levels'}
function go(v,i){if(v=='level'&&i>0&&!st.d[i])playLevelOpen();view=v;if(i!=null)cur=i;wrong=false;show();M.focus();window.scrollTo(0,0)}
function show(){head();if(view=='welcome')return welcome();if(view=='dash')return dash();if(view=='final')return fin();lvl()}
function welcome(){M.innerHTML=`<div class="card sage"><h2>Welcome!</h2><p>When you take a medicine again and again, some of each earlier dose is still in the body. In this game you explore the number pattern behind that idea: <b>geometric sequences and series</b>. You will predict, calculate and build a limit across eight levels. No reading needed first.</p><p><b>This is a simplified mathematics game—not medical advice. Its values are illustrative and must not be used to choose, change, or assess medication doses.</b></p><button class="p" id="go">Start playing</button></div>`;$('#go').onclick=()=>{playStart();go('dash')}}
function dash(){const nx=st.d.indexOf(false);M.innerHTML=`<h2>Choose a level</h2><div class="grid">${LV.map((l,i)=>{const lk=i>0&&!st.d[i-1];return `<button class="lc" data-i="${i}" ${lk?'disabled':''}><b>Level ${i+1}${st.d[i]?' ✔ Completed':lk?' 🔒 Locked':''}</b><small>${l.t}</small><small>${l.g}</small></button>`}).join('')}</div>${nx<0?'<p><button class="p" id="fin">View completion screen</button></p>':''}`;M.onclick=e=>{const b=e.target.closest('.lc');if(b)go('level',+b.dataset.i)};if(nx<0)$('#fin').onclick=()=>go('final')}
function lvl(){const l=LV[cur];M.innerHTML=`<h2>Level ${cur+1}: ${l.t}</h2><p><b>Goal:</b> ${l.g}</p><p>${l.i}</p><div id="lv"></div><div class="row"><button class="p" id="chk">Check Answer</button><button id="hb">💡 Hint</button></div><div id="hn"></div><div id="fb" class="nt" role="status"></div><div id="ex" hidden></div><div class="row"><button id="bk">← Levels</button><button class="p" id="nxt" disabled>${cur==7?'Finish ▶':'Next Level ▶'}</button></div>`;
l.m($('#lv'));M.onclick=null;$('#hb').onclick=()=>{playHint();$('#hn').innerHTML=`<div class="hint"><b>Hint:</b> ${l.h}</div>`};$('#bk').onclick=()=>go('dash');$('#nxt').onclick=()=>go(cur==7?'final':'level',cur+1);if(st.d[cur])unlock(false);
$('#chk').onclick=()=>{const r=l.c();if(r.k===null)return fb('nt',r.m);if(r.k==='q'){if(r.m){fb('ok',r.m,1);if(r.iv){playIntervalChange();setTimeout(playCorrect,90)}else playCorrect()}return}
if(r.k===false){wrong=true;return fb('no',r.m)}fb('ok',r.m,1);unlock(true)};
}
function unlock(first){let m='Completed earlier — no extra points for repeats.';if(first&&!st.d[cur]){st.d[cur]=true;st.s+=100;m='+100 points';if(!wrong){st.f[cur]=true;st.s+=20;m='+100 points + 20 first-attempt bonus'}save();head()}
if(first){if(cur==7)playGameComplete();else playLevelComplete()}$('#nxt').disabled=false;$('#ex').hidden=false;$('#ex').innerHTML=`<div class="card sage"><b>Why it works:</b> ${LV[cur].x}<br><b>${m}</b></div>`}
function fin(){M.innerHTML=`<div class="card sage"><h2>You built the limit!</h2><p><b>Total score: ${st.s} / 960</b></p><p>All eight levels: ${st.d.map((d,i)=>`${i+1}${d?' ✔':' ✖'}`).join(' · ')}</p></div><div class="card pl"><h3>Key formulas</h3><p class="eq">Sequence: a<sub>n</sub> = 100(0.5)<sup>n−1</sup></p><p class="eq">Recurrence: S<sub>n</sub> = rS<sub>n−1</sub> + D, S<sub>0</sub> = 0</p><p class="eq">Finite sum: S<sub>n</sub> = D(1 − r<sup>n</sup>)/(1 − r), r ≠ 1</p><p class="eq">Limit: S<sub>∞</sub> = D/(1 − r) = 200 mg (for r = 0.5, just after a dose)</p></div><p>This game is an illustrative model, not medical advice.</p><div class="row"><button class="p" id="rv">Review levels</button><button id="rs">Restart game</button></div>`;$('#rv').onclick=()=>go('dash');$('#rs').onclick=()=>{st={d:Array(8).fill(false),f:Array(8).fill(false),s:0};save();go('welcome')}}
const sndB=$('#sndB'),volS=$('#vol'),sS=$('#sndS');
function sui(m){sndB.textContent=Aud.on()?'🔊 Sound: On':'🔇 Sound: Off';sndB.setAttribute('aria-pressed',Aud.on());volS.value=Math.round(Aud.vol()*100);$('#vv').textContent=volS.value+'%';if(m!=null)sS.textContent=m}
sui(Aud.on()?'Sound was on last time. It resumes after your first click or key press.':'Sound is off. Press the button to turn it on; the game works fully without sound.');
['pointerdown','keydown'].forEach(e=>document.addEventListener(e,()=>Aud.arm(),{capture:true,passive:true}));
document.addEventListener('visibilitychange',()=>{if(document.hidden)Aud.stop()});
sndB.onclick=()=>{Aud.setOn(!Aud.on());sui(Aud.on()?'Sound on. Press “Preview sound” to hear a sample.':'Sound off.')};
volS.oninput=()=>{Aud.setVol(volS.value/100);$('#vv').textContent=volS.value+'%'};
$('#prevB').onclick=()=>{if(!Aud.on()){sS.textContent='Turn sound on first to preview.';return}playCorrect();sS.textContent='Preview played: the correct-answer sound.'};
M.addEventListener('change',e=>{const t=e.target;if(t.matches('select'))(/^[ms]\d$/.test(t.id)?playMove:playSelect)();else if(t.matches('input[type=radio],input[type=checkbox]'))playSelect()});
$('#home').onclick=()=>go('dash');$('#infoB').onclick=e=>{const i=$('#info');i.hidden=!i.hidden;e.target.setAttribute('aria-expanded',!i.hidden)};
$('#rstB').onclick=()=>{$('#rst').hidden=false;$('#rN').focus()};$('#rN').onclick=()=>{$('#rst').hidden=true};$('#rY').onclick=()=>{playReset();st={d:Array(8).fill(false),f:Array(8).fill(false),s:0};save();$('#rst').hidden=true;go('welcome')};
show();
</script></body></html>
