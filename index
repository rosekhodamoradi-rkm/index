const a=$('#b1'),c=$('#b2');a.onclick=()=>{playRetain();ph=1;draw(cv);$('#v').focus()};c.onclick=()=>{playAdd();ph=3;draw(cv);$('#v').focus()}};
b.st=()=>({T,k,ph});b.adv=(nv)=>{ph++;draw(nv)};b.fin=nv=>{T.push(nv);k++;ph=0;draw(nv)};b.get=()=>[T,k,ph];draw(100)},
c(){const b=M.querySelector('#lv'),[T,k,ph]=b.get();if(ph==0)return{k:null,m:'Start by selecting “Retain half”.'};if(ph==2)return{k:null,m:'Now select “Add 100”.'};const v=num($('#v').value);if(v===null||isNaN(v))return{k:null,m:'Please type a number.'};const pr=T[T.length-1];
