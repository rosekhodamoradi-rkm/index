m(b){const o=['','100','50','25','12.5','200'];b.innerHTML=`<div class="card pl"><p class="eq">a<sub>n</sub> = 100(0.5)<sup>n−1</sup></p>`+[1,2,3,4].map(n=>`<label>a<sub>${n}</sub> = <select id="m${n}" aria-label="Value of a ${n}">${o.map(v=>`<option>${v}</option>`).join('')}</select> mg</label>`).join('')+`<p>What is a<sub>5</sub>? ${inp('a5','value of a 5')} mg</p></div>`},
